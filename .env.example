# ──────────────────────────────────────────────────────
# Copia este archivo como .env y rellena tus valores
# cp .env.example .env
# ──────────────────────────────────────────────────────

# API Key de Groq (gratuita en https://console.groq.com)
GROQ_API_KEY=tu_api_key_aqui

# Modelo LLM a usar
GROQ_MODEL=llama-3.2-90b-text-preview

# Ruta local de ChromaDB (no cambiar)
CHROMA_DB_PATH=./data/chroma_db

# Ruta de los documentos del corpus
DATA_PATH=./data/documentos

# API de clima (gratuita en https://openweathermap.org)
OPENWEATHER_API_KEY=tu_api_key_aqui
